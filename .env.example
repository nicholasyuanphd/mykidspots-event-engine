# Required: Supabase direct connection string (not pooled)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# Optional: Override sources directory (default: ./sources)
SOURCES_DIR=./sources

# Optional: Max concurrent source scrapes (default: 5)
MAX_CONCURRENCY=5

# Optional: Log level (default: INFO)
LOG_LEVEL=INFO
